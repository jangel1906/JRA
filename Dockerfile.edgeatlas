FROM python:3.11-slim

WORKDIR /app

# Install dependencies
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# Copy application code
COPY edge_atlas/ ./edge_atlas/
COPY edge_atlas_app.py .

# Set environment variables
ENV PORT=8080
ENV PYTHONUNBUFFERED=1

# Expose port
EXPOSE 8080

# Run the application
CMD exec gunicorn edge_atlas_app:server --bind 0.0.0.0:$PORT --workers 1 --threads 8 --timeout 0
